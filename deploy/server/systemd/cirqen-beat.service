[Unit]
Description=Cirqen scheduled tasks (Celery beat: backups, PPM, updates)
After=network-online.target redis-server.service
Requires=redis-server.service

[Service]
Type=simple
User=cirqen
Group=cirqen
WorkingDirectory=/opt/cirqen/app
EnvironmentFile=/etc/cirqen/cirqen.env
ExecStart=/opt/cirqen/venv/bin/celery -A Equiper beat --loglevel=INFO \
    --schedule /var/lib/cirqen/celerybeat-schedule
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/cirqen

[Install]
WantedBy=multi-user.target
