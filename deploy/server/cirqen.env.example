# /etc/cirqen/cirqen.env — hospital server mode (see docs/SERVER_MODE.md).
# install.sh writes this file with generated secrets; edit the marked values.
# Readable by root and the cirqen user only (mode 640).

# ── Where Cirqen keeps its data (config.json, logs, backups, static files) ──
CIRQEN_DATA_DIR=/var/lib/cirqen
DJANGO_SETTINGS_MODULE=Equiper.settings
DJANGO_DEBUG=0
DJANGO_SECRET_KEY=change-me-generated-by-install

# ── How the hospital reaches the server (EDIT) ──
# Every name or address people type in the browser, comma-separated.
DJANGO_ALLOWED_HOSTS=cirqen.hospital.local,10.0.0.20
# The address in emails and on asset QR labels (install.sh sets it).
CIRQEN_SITE_URL=https://cirqen.hospital.local
# HTTPS through nginx on this machine.
CIRQEN_HTTPS=1
CIRQEN_BEHIND_PROXY=1

# ── Local database and cache on this server ──
POSTGRES_LOCAL_HOST=127.0.0.1
POSTGRES_LOCAL_PORT=5432
POSTGRES_LOCAL_DB=cirqen
POSTGRES_LOCAL_USER=cirqen
POSTGRES_LOCAL_PASSWORD=change-me-generated-by-install
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# ── Link to Cirqen HQ (EDIT: from Cirqen Labs) ──
# A one-time enrollment code; the sync agent exchanges it for this site's own key.
SYNC_ENROLLMENT_CODE=
# Only if Cirqen Labs gives you non-default addresses:
# SYNC_API_URL=https://hq.example/api/sync
# HQ_SERVER_URL=https://updates.example

# ── Backups (EDIT) ──
# A second copy of every nightly backup, off this server's disk: a mounted
# network share, NAS or USB disk. Leave empty only if you back up the server
# some other way.
CIRQEN_BACKUP_COPY_DIR=
# Daily backups kept (here and in the copy): 30 days.
CIRQEN_BACKUP_KEEP=30

# ── Optional ──
# SENTRY_DSN=
