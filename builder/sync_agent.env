# ============================================================
# CIRQEN SYNC AGENT — Site .env
# Place this at the root of your Cirqen desktop app folder
# ============================================================

# ── HQ Server (Render) ────────────────────────────────────
SYNC_API_URL=https://hq-server-dgs6.onrender.com/api/sync
HQ_UPDATE_URL=https://hq-server-dgs6.onrender.com/api/updates

# ── Auth — MUST match SYNC_AUTH_TOKEN on the HQ server ───
SYNC_AUTH_TOKEN=change_me_to_a_long_random_secret

# ── HQ PostgreSQL (Render) ────────────────────────────────
POSTGRES_HQ_HOST=<hq-db-host>
POSTGRES_HQ_PORT=5432
POSTGRES_HQ_DB=<hq-db-name>
POSTGRES_HQ_USER=<hq-db-user>
POSTGRES_HQ_PASSWORD=<hq-db-password>

# ── Local PostgreSQL (this site's database) ───────────────
POSTGRES_LOCAL_HOST=127.0.0.1
POSTGRES_LOCAL_PORT=2215
POSTGRES_LOCAL_DB=cirqen1
POSTGRES_LOCAL_USER=cirqen1
POSTGRES_LOCAL_PASSWORD=<local-db-password>

# ── Local Redis ───────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=7788
REDIS_PASSWORD=
