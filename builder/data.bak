python manage.py migrate --database=hq
python -c "
import json
with open('/home/maina/.cirqen/data/config.json', 'r') as f:
    cfg = json.load(f)

import os
cfg['hq_db']['host'] = os.environ['POSTGRES_HQ_HOST']
cfg['hq_db']['port'] = int(os.environ.get('POSTGRES_HQ_PORT', '5432'))
cfg['hq_db']['database'] = os.environ['POSTGRES_HQ_DB']
cfg['hq_db']['user'] = os.environ['POSTGRES_HQ_USER']
cfg['hq_db']['password'] = os.environ['POSTGRES_HQ_PASSWORD']
cfg['hq_db']['enabled'] = True

with open('/home/maina/.cirqen/data/config.json', 'w') as f:
    json.dump(cfg, f, indent=2)

print('Done. HQ DB updated to Render.')
print('Host:', cfg['hq_db']['host'])
"
