/* ===================================
   BASE LAYOUT - EQUIPER
   Theme: Black & Silver
   =================================== */

@import url('https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,300;9..40,400;9..40,500;9..40,600;9..40,700&family=DM+Mono:wght@400;500&display=swap');

/* ===================================
   DESIGN TOKENS — LIGHT (Silver)
   =================================== */
:root,
[data-theme="light"] {
  /* Backgrounds */
  --bg-primary: #f2f2f2;
  --bg-secondary: #e8e8e8;
  --bg-tertiary: #dcdcdc;
  --bg-card: #ffffff;
  --bg-hover: #d4d4d4;

  /* Text */
  --text-primary: #111111;
  --text-secondary: #444444;
  --text-muted: #777777;

  /* Borders */
  --border-color: #c0c0c0;
  --border-light: #d8d8d8;

  /* Accent — silver-black */
  --accent: #1a1a1a;
  --accent-light: rgba(26, 26, 26, 0.08);
  --accent-mid: #333333;

  /* Inputs */
  --input-bg: #ffffff;
  --input-border: #b0b0b0;
  --input-focus-border: #1a1a1a;
  --input-focus-shadow: 0 0 0 3px rgba(26, 26, 26, 0.12);

  /* Danger */
  --danger-color: #cc2200;

  /* Shadows */
  --shadow-sm: 0 1px 4px rgba(0, 0, 0, 0.10);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.12);
  --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.14);
  --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.16);

  /* Misc */
  --btn-close-filter: none;
  --primary-color: #1a1a1a;
  --primary-light: rgba(26, 26, 26, 0.1);

  /* Layout */
  --header-height: 70px;
  --footer-height: 60px;
  --sidebar-width: 260px;
  --sidebar-collapsed-width: 70px;
  --transition-speed: 0.3s;
  --transition-timing: cubic-bezier(0.4, 0, 0.2, 1);

  /* Font */
  --font-base: 'DM Sans', 'Segoe UI', system-ui, sans-serif;
  --font-mono: 'DM Mono', monospace;
}

/* ===================================
   DESIGN TOKENS — DARK (Black)
   =================================== */
[data-theme="dark"] {
  /* Backgrounds — true black layered */
  --bg-primary: #0a0a0a;
  --bg-secondary: #111111;
  --bg-tertiary: #1a1a1a;
  --bg-card: #141414;
  --bg-hover: #252525;

  /* Text — silver spectrum */
  --text-primary: #e8e8e8;
  --text-secondary: #a0a0a0;
  --text-muted: #666666;

  /* Borders — subtle silver lines */
  --border-color: rgba(192, 192, 192, 0.12);
  --border-light: rgba(192, 192, 192, 0.07);

  /* Accent — silver on black */
  --accent: #c0c0c0;
  --accent-light: rgba(192, 192, 192, 0.08);
  --accent-mid: #888888;

  /* Inputs */
  --input-bg: #1a1a1a;
  --input-border: rgba(192, 192, 192, 0.2);
  --input-focus-border: #c0c0c0;
  --input-focus-shadow: 0 0 0 3px rgba(192, 192, 192, 0.12);

  /* Danger */
  --danger-color: #ff4422;

  /* Shadows — deep black */
  --shadow-sm: 0 1px 4px rgba(0, 0, 0, 0.5);
  --shadow-md: 0 4px 16px rgba(0, 0, 0, 0.6);
  --shadow-lg: 0 8px 32px rgba(0, 0, 0, 0.7);
  --shadow-xl: 0 16px 48px rgba(0, 0, 0, 0.8);

  /* Misc */
  --btn-close-filter: invert(1);
  --primary-color: #c0c0c0;
  --primary-light: rgba(192, 192, 192, 0.1);
}

/* ===================================
   GLOBAL RESET
   =================================== */
*,
*::before,
*::after {
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  font-family: var(--font-base);
  font-size: 0.9375rem;
  font-weight: 400;
  line-height: 1.6;
  background-color: var(--bg-primary);
  color: var(--text-primary);
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
  transition:
    background-color var(--transition-speed) var(--transition-timing),
    color var(--transition-speed) var(--transition-timing);
}

/* ===================================
   MAIN WRAPPER
   =================================== */
.main-wrapper {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  transition: margin-left var(--transition-speed) var(--transition-timing);
  position: relative;
}

.main-wrapper.with-sidebar {
  margin-left: var(--sidebar-width);
}

.main-wrapper.with-sidebar.sidebar-hidden {
  margin-left: 0;
}

/* ===================================
   APP HEADER
   =================================== */
.app-header {
  height: var(--header-height);
  background-color: var(--bg-secondary);
  border-bottom: 1px solid var(--border-color);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0 1.5rem;
  position: sticky;
  top: 0;
  z-index: 99;
  transition:
    background-color var(--transition-speed) var(--transition-timing),
    border-color var(--transition-speed) var(--transition-timing);
}

[data-theme="dark"] .app-header {
  background-color: var(--bg-secondary);
  box-shadow: 0 1px 0 var(--border-color), var(--shadow-sm);
}

.header-left {
  display: flex;
  align-items: center;
  gap: 1.25rem;
}

.header-right {
  display: flex;
  align-items: center;
  gap: 0.375rem;
}

/* ===================================
   PAGE TITLE
   =================================== */
.page-title {
  font-family: var(--font-base);
  font-size: 1.25rem;
  font-weight: 600;
  color: var(--text-primary);
  margin: 0;
  white-space: nowrap;
  letter-spacing: -0.02em;
}

[data-theme="dark"] .page-title {
  color: var(--text-primary);
}

/* ===================================
   HAMBURGER BUTTON
   =================================== */
.hamburger-menu {
  background: transparent;
  border: none;
  width: 42px;
  height: 42px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 5px;
  cursor: pointer;
  border-radius: 10px;
  padding: 10px;
  transition: all 0.25s var(--transition-timing);
  flex-shrink: 0;
}

.hamburger-menu:hover {
  background-color: var(--bg-hover);
}

.hamburger-menu:active {
  transform: scale(0.93);
}

.hamburger-line {
  width: 22px;
  height: 2px;
  background-color: var(--text-primary);
  border-radius: 2px;
  transition: all 0.3s var(--transition-timing);
  display: block;
}

/* X state */
.hamburger-menu.active .hamburger-line:nth-child(1) {
  transform: translateY(7px) rotate(45deg);
}

.hamburger-menu.active .hamburger-line:nth-child(2) {
  opacity: 0;
  transform: translateX(-8px);
}

.hamburger-menu.active .hamburger-line:nth-child(3) {
  transform: translateY(-7px) rotate(-45deg);
}

/* ===================================
   ICON BUTTONS
   =================================== */
.icon-btn {
  background: transparent;
  border: 1px solid transparent;
  border-radius: 10px;
  width: 42px;
  height: 42px;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: all 0.25s var(--transition-timing);
  color: var(--text-secondary);
  text-decoration: none;
  position: relative;
}

.icon-btn:hover {
  background-color: var(--bg-hover);
  border-color: var(--border-color);
  color: var(--text-primary);
  transform: translateY(-1px);
  box-shadow: var(--shadow-sm);
}

.icon-btn:active {
  transform: translateY(0) scale(0.95);
}

.icon-btn i {
  font-size: 1.1rem;
  transition: all 0.25s var(--transition-timing);
}

.icon-btn:hover i {
  transform: scale(1.1);
}

/* Logout */
.logout-btn:hover {
  background-color: rgba(204, 34, 0, 0.08);
  border-color: var(--danger-color);
  color: var(--danger-color);
}

[data-theme="dark"] .logout-btn:hover {
  background-color: rgba(255, 68, 34, 0.1);
  border-color: var(--danger-color);
  color: var(--danger-color);
}

/* ===================================
   THEME TOGGLE ICONS
   ===================================
   Light mode  → sun visible
   Dark mode   → moon visible
   =================================== */
.icon-btn .light-icon,
.icon-btn .dark-icon {
  position: absolute;
  transition: all 0.35s var(--transition-timing);
}

/* Light mode: sun shown, moon hidden */
.icon-btn .light-icon {
  opacity: 1;
  transform: rotate(0deg) scale(1);
  color: #888888;
}

.icon-btn .dark-icon {
  opacity: 0;
  transform: rotate(90deg) scale(0.5);
  color: #a0a0a0;
}

/* Dark mode: moon shown, sun hidden */
[data-theme="dark"] .icon-btn .light-icon {
  opacity: 0;
  transform: rotate(-90deg) scale(0.5);
}

[data-theme="dark"] .icon-btn .dark-icon {
  opacity: 1;
  transform: rotate(0deg) scale(1);
}

/* ===================================
   MAIN CONTENT
   =================================== */
.app-main {
  flex: 1;
  padding: 0;
  background-color: var(--bg-primary);
  min-height: calc(100vh - var(--header-height));
  width: 100%;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* ===================================
   FOOTER
   =================================== */
.app-footer {
  background-color: var(--bg-secondary);
  border-top: 1px solid var(--border-color);
  padding: 0.5rem 1rem;
  margin-top: auto;
}

.footer-content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  width: 100%;
}

.footer-left {
  display: flex;
  align-items: center;
  gap: 1rem;
}

.footer-logo {
  height: 30px;
  width: auto;
}

.footer-left p,
.footer-right p {
  margin: 0;
  font-family: var(--font-mono);
  font-size: 0.75rem;
  color: var(--text-muted);
  letter-spacing: 0.04em;
}

/* ===================================
   CARDS
   =================================== */
.card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  color: var(--text-primary);
  box-shadow: var(--shadow-sm);
  transition:
    background-color var(--transition-speed) var(--transition-timing),
    border-color var(--transition-speed) var(--transition-timing),
    box-shadow var(--transition-speed) var(--transition-timing);
}

.card:hover {
  box-shadow: var(--shadow-md);
}

.card-header {
  background-color: var(--bg-tertiary);
  border-bottom: 1px solid var(--border-color);
  color: var(--text-primary);
  font-weight: 600;
  border-radius: 12px 12px 0 0;
}

.card-body {
  background-color: var(--bg-card);
  color: var(--text-primary);
}

.card-footer {
  background-color: var(--bg-tertiary);
  border-top: 1px solid var(--border-color);
  color: var(--text-secondary);
  border-radius: 0 0 12px 12px;
}

[data-theme="dark"] .card {
  background-color: var(--bg-card);
  border-color: var(--border-color);
}

/* ===================================
   TABLES
   =================================== */
table,
.table {
  background-color: var(--bg-card);
  color: var(--text-primary);
  border-color: var(--border-color);
}

table thead th,
.table thead th {
  background-color: var(--bg-tertiary);
  color: var(--text-primary);
  border-color: var(--border-color);
  font-weight: 600;
  font-size: 0.8125rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

table tbody td,
.table tbody td {
  background-color: var(--bg-card);
  color: var(--text-primary);
  border-color: var(--border-color);
}

table tbody tr:hover td,
.table tbody tr:hover td,
.table-hover tbody tr:hover td {
  background-color: var(--bg-hover);
}

.table-striped tbody tr:nth-of-type(odd) td {
  background-color: var(--bg-tertiary);
}

.table-responsive {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  overflow: hidden;
}

/* ===================================
   FORMS
   =================================== */
.form-label {
  color: var(--text-primary);
  font-weight: 500;
  font-size: 0.875rem;
  margin-bottom: 0.4rem;
}

.form-control,
.form-select {
  background-color: var(--input-bg);
  border: 1.5px solid var(--input-border);
  color: var(--text-primary);
  border-radius: 8px;
  padding: 0.55rem 0.875rem;
  font-family: var(--font-base);
  font-size: 0.875rem;
  transition:
    border-color 0.2s,
    background-color 0.2s,
    box-shadow 0.2s;
}

.form-control:focus,
.form-select:focus {
  background-color: var(--input-bg);
  border-color: var(--input-focus-border);
  color: var(--text-primary);
  box-shadow: var(--input-focus-shadow);
  outline: none;
}

.form-control::placeholder {
  color: var(--text-muted);
}

.form-select option {
  background-color: var(--bg-secondary);
  color: var(--text-primary);
}

.form-check-input {
  background-color: var(--input-bg);
  border: 1.5px solid var(--input-border);
  width: 1.1rem;
  height: 1.1rem;
  cursor: pointer;
  transition: all 0.2s;
}

.form-check-input:checked {
  background-color: var(--accent);
  border-color: var(--accent);
}

.form-check-label {
  color: var(--text-primary);
  cursor: pointer;
  font-size: 0.875rem;
}

.form-text {
  color: var(--text-muted);
  font-size: 0.8rem;
}

/* ===================================
   MODAL
   =================================== */
.modal-content {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  box-shadow: var(--shadow-xl);
  color: var(--text-primary);
}

.modal-header {
  border-bottom: 1px solid var(--border-color);
  background-color: var(--bg-tertiary);
  border-radius: 14px 14px 0 0;
}

.modal-title {
  color: var(--text-primary);
  font-weight: 600;
  letter-spacing: -0.01em;
}

.modal-body {
  background-color: var(--bg-card);
  color: var(--text-primary);
}

.modal-footer {
  border-top: 1px solid var(--border-color);
  background-color: var(--bg-tertiary);
  border-radius: 0 0 14px 14px;
}

.btn-close {
  filter: var(--btn-close-filter);
}

[data-theme="dark"] .modal-backdrop {
  background-color: rgba(0, 0, 0, 0.85);
}

/* ===================================
   SETTINGS PANEL
   =================================== */
.settings-section {
  padding: 1rem 0;
  border-bottom: 1px solid var(--border-light);
}

.settings-section:last-child {
  border-bottom: none;
}

.settings-section h6 {
  color: var(--text-primary);
  font-weight: 600;
  font-size: 0.8125rem;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  margin-bottom: 1rem;
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.setting-item {
  margin-bottom: 1rem;
}

/* ===================================
   USER PROFILE (HEADER)
   =================================== */
.user-profile {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.5rem 1rem;
  border-radius: 10px;
  background-color: var(--bg-tertiary);
  border: 1px solid var(--border-color);
  margin-left: 0.25rem;
  cursor: pointer;
  transition: all 0.2s var(--transition-timing);
}

.user-profile:hover {
  background-color: var(--bg-hover);
  border-color: var(--accent-mid);
}

.user-avatar {
  font-size: 1.75rem;
  color: var(--accent);
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
}

.user-info-header {
  display: flex;
  flex-direction: column;
}

.user-name {
  font-weight: 600;
  font-size: 0.875rem;
  color: var(--text-primary);
  white-space: nowrap;
  line-height: 1.2;
  letter-spacing: -0.01em;
}

.user-role {
  font-family: var(--font-mono);
  font-size: 0.7rem;
  color: var(--text-muted);
  letter-spacing: 0.04em;
  line-height: 1.3;
}

/* ===================================
   LEGACY CLEANUP
   =================================== */
.sidebar-toggle,
.theme-toggle-container,
.theme-toggle-btn,
.user-menu,
.user-menu-btn {
  display: none !important;
}

/* ===================================
   SCROLLBAR — THEMED
   =================================== */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}

::-webkit-scrollbar-track {
  background: transparent;
}

::-webkit-scrollbar-thumb {
  background: var(--border-color);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb:hover {
  background: var(--text-muted);
}

/* ===================================
   RESPONSIVE
   =================================== */
@media (max-width: 768px) {
  .app-header {
    padding: 0 1rem;
  }

  .header-left {
    gap: 0.875rem;
  }

  .page-title {
    font-size: 1.1rem;
  }

  .user-info-header {
    display: none;
  }

  .user-profile {
    padding: 0.5rem;
  }

  .app-main {
    padding: 0;
  }

  .footer-content {
    flex-direction: column;
    text-align: center;
    gap: 0.5rem;
  }

  .main-wrapper.with-sidebar {
    margin-left: 0;
  }

  .header-right {
    gap: 0.2rem;
  }

  .icon-btn {
    width: 38px;
    height: 38px;
  }
}

@media (max-width: 480px) {
  .page-title {
    font-size: 0.95rem;
  }

  .app-header {
    height: 60px;
    padding: 0 0.75rem;
  }

  .header-left {
    gap: 0.5rem;
  }

  .hamburger-menu {
    width: 38px;
    height: 38px;
  }

  .icon-btn {
    width: 34px;
    height: 34px;
  }

  .icon-btn i {
    font-size: 0.95rem;
  }
}

/* ===================================
   ACCESSIBILITY
   =================================== */
.icon-btn:focus-visible,
.hamburger-menu:focus-visible,
.form-control:focus-visible,
.form-select:focus-visible {
  outline: 2px solid var(--accent);
  outline-offset: 2px;
}

@media (prefers-reduced-motion: reduce) {

  *,
  *::before,
  *::after {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
  }
}
