/* ============================================================
   EQUIPER THEME SYSTEM
   Black & Silver — light / dark
   NO blue. Primary accent is black (light) / silver (dark).
   ============================================================ */

/* ============================================================
   LIGHT THEME — Silver & Black
   ============================================================ */
:root,
[data-theme="light"] {
  /* Brand / Primary — near-black */
  --primary-color: #1a1a1a;
  --primary-hover: #000000;
  --primary-light: #e8e8e8;
  --primary-gradient: linear-gradient(135deg, #1a1a1a 0%, #000000 100%);

  /* Semantic — kept neutral */
  --secondary-color: #555555;
  --success-color: #1a7a4a;
  --danger-color: #cc2200;
  --warning-color: #b07800;
  --info-color: #336699;

  /* Surfaces */
  --bg-primary: #f2f2f2;
  --bg-secondary: #e8e8e8;
  --bg-tertiary: #dcdcdc;
  --bg-hover: #d0d0d0;
  --bg-card: #ffffff;

  /* Text */
  --text-primary: #111111;
  --text-secondary: #444444;
  --text-muted: #888888;
  --text-white: #ffffff;

  /* Borders & Shadows */
  --border-color: #c8c8c8;
  --border-light: #dcdcdc;
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.10);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.13);
  --shadow-lg: 0 10px 24px rgba(0, 0, 0, 0.16);
  --shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.20);

  /* Inputs */
  --input-bg: #ffffff;
  --input-border: #b8b8b8;
  --input-focus-border: #1a1a1a;
  --input-focus-shadow: 0 0 0 3px rgba(26, 26, 26, 0.12);

  /* Scrollbar */
  --scrollbar-track: #e0e0e0;
  --scrollbar-thumb: #b0b0b0;
  --scrollbar-thumb-hover: #888888;

  /* Misc */
  --btn-close-filter: invert(0);
  --header-bg: #e8e8e8;
  --header-border: #c8c8c8;
  --header-shadow: 0 1px 6px rgba(0, 0, 0, 0.08);

  /* Accent alias (used by sidebar & base) */
  --accent: #1a1a1a;
  --accent-mid: #555555;
}

/* ============================================================
   DARK THEME — Black & Silver
   ============================================================ */
[data-theme="dark"] {
  /* Brand / Primary — silver */
  --primary-color: #c0c0c0;
  --primary-hover: #e0e0e0;
  --primary-light: #2a2a2a;
  --primary-gradient: linear-gradient(135deg, #c0c0c0 0%, #a0a0a0 100%);

  /* Semantic */
  --secondary-color: #888888;
  --success-color: #22c55e;
  --danger-color: #ff5533;
  --warning-color: #f59e0b;
  --info-color: #5599cc;

  /* Surfaces — true black stack */
  --bg-primary: #0a0a0a;
  --bg-secondary: #111111;
  --bg-tertiary: #1a1a1a;
  --bg-hover: #242424;
  --bg-card: #141414;

  /* Text — silver spectrum */
  --text-primary: #e8e8e8;
  --text-secondary: #a8a8a8;
  --text-muted: #606060;
  --text-white: #ffffff;

  /* Borders & Shadows */
  --border-color: rgba(255, 255, 255, 0.08);
  --border-light: rgba(255, 255, 255, 0.04);
  --shadow-sm: 0 1px 3px rgba(0, 0, 0, 0.45);
  --shadow-md: 0 4px 12px rgba(0, 0, 0, 0.55);
  --shadow-lg: 0 10px 24px rgba(0, 0, 0, 0.65);
  --shadow-xl: 0 20px 40px rgba(0, 0, 0, 0.75);

  /* Inputs */
  --input-bg: #1a1a1a;
  --input-border: rgba(255, 255, 255, 0.12);
  --input-focus-border: #c0c0c0;
  --input-focus-shadow: 0 0 0 3px rgba(192, 192, 192, 0.12);

  /* Scrollbar */
  --scrollbar-track: #1a1a1a;
  --scrollbar-thumb: #3a3a3a;
  --scrollbar-thumb-hover: #606060;

  /* Misc */
  --btn-close-filter: invert(1) brightness(2);
  --header-bg: #111111;
  --header-border: rgba(255, 255, 255, 0.08);
  --header-shadow: 0 1px 6px rgba(0, 0, 0, 0.5);

  /* Accent alias */
  --accent: #c0c0c0;
  --accent-mid: #888888;
}

/* ============================================================
   THEME TRANSITIONS
   ============================================================ */
html,
body {
  transition: background-color 0.25s ease, color 0.25s ease;
}

*,
*::before,
*::after {
  transition-property: background-color, border-color, color, box-shadow;
  transition-duration: 0.22s;
  transition-timing-function: ease;
}

/* Interactive elements — snappy, no lag */
button,
a,
input,
select,
textarea,
[role="button"],
.btn,
.icon-btn,
#themeToggle,
#sidebarToggle {
  transition-property: background-color, border-color, color,
    box-shadow, transform, opacity;
  transition-duration: 0.14s;
  transition-timing-function: cubic-bezier(0.4, 0, 0.2, 1);
}

/* No-transition class — used by anti-flash script on load */
.no-transition,
.no-transition *,
.no-transition *::before,
.no-transition *::after {
  transition: none !important;
  animation: none !important;
}

/* ============================================================
   THEME TOGGLE ICON
   Swap sun / moon instantly
   ============================================================ */
.light-icon,
.dark-icon {
  transition: opacity 0.1s ease !important;
}

[data-theme="light"] .light-icon {
  display: inline-block !important;
  opacity: 1;
}

[data-theme="light"] .dark-icon {
  display: none !important;
}

[data-theme="dark"] .light-icon {
  display: none !important;
}

[data-theme="dark"] .dark-icon {
  display: inline-block !important;
  opacity: 1;
}

/* ============================================================
   BODY
   ============================================================ */
body {
  background-color: var(--bg-primary);
  color: var(--text-primary);
}

/* ============================================================
   BUTTONS
   ============================================================ */
.btn {
  font-weight: 600;
  letter-spacing: 0.02em;
  border-radius: 8px;
  padding: 0.625rem 1.25rem;
  border: none;
  box-shadow: var(--shadow-sm);
  position: relative;
}

.btn:not(.dropdown-toggle) {
  overflow: hidden;
}

.btn:hover {
  transform: translateY(-1px);
  box-shadow: var(--shadow-md);
}

.btn:active {
  transform: translateY(0);
  box-shadow: var(--shadow-sm);
}

.btn-primary {
  background: var(--primary-gradient);
  color: var(--text-white);
}

.btn-secondary {
  background: var(--secondary-color);
  color: var(--text-white);
}

.btn-success {
  background: linear-gradient(135deg, var(--success-color), #155e3a);
  color: var(--text-white);
}

.btn-danger {
  background: linear-gradient(135deg, var(--danger-color), #991100);
  color: var(--text-white);
}

.btn-warning {
  background: linear-gradient(135deg, var(--warning-color), #92600a);
  color: var(--text-white);
}

.btn-info {
  background: linear-gradient(135deg, var(--info-color), #224466);
  color: var(--text-white);
}

.btn-primary:hover,
.btn-secondary:hover,
.btn-success:hover,
.btn-danger:hover,
.btn-warning:hover,
.btn-info:hover {
  filter: brightness(1.1);
  color: var(--text-white);
}

.btn-outline-primary {
  background: transparent;
  border: 2px solid var(--primary-color);
  color: var(--primary-color);
}

.btn-outline-primary:hover {
  background: var(--primary-gradient);
  color: var(--text-white);
  border-color: transparent;
}

.btn-sm {
  padding: 0.4rem 0.875rem;
  font-size: 0.875rem;
}

.btn-lg {
  padding: 6px 12px 1.5rem;
  font-size: 1.125rem;
}

/* ============================================================
   CARDS
   ============================================================ */
.card {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 12px;
  box-shadow: var(--shadow-sm);
  color: var(--text-primary);
}

.card:hover {
  box-shadow: var(--shadow-md);
  transform: translateY(-1px);
}

.card-header {
  background: var(--bg-tertiary);
  border-bottom: 1px solid var(--border-color);
  border-radius: 12px 12px 0 0;
  padding: 1rem 1.25rem;
  font-weight: 600;
  color: var(--text-primary);
}

.card-body {
  padding: 1.25rem;
  color: var(--text-primary);
}

.card-footer {
  background: var(--bg-tertiary);
  border-top: 1px solid var(--border-color);
  border-radius: 0 0 12px 12px;
  padding: 0.875rem 1.25rem;
  color: var(--text-secondary);
}

/* ============================================================
   ALERTS
   ============================================================ */
.alert {
  border-radius: 10px;
  border: none;
  padding: 0.875rem 1.125rem;
  font-weight: 500;
  box-shadow: var(--shadow-sm);
}

/* Equiper custom alert layout */
.equiper-alert {
  display: flex;
  align-items: center;
}

.alert-inner {
  display: flex;
  align-items: center;
  gap: 0.625rem;
  flex: 1;
}

.alert-icon {
  font-size: 1.1rem;
  flex-shrink: 0;
}

.alert-success {
  background: linear-gradient(135deg, var(--success-color), #155e3a);
  color: #fff;
}

.alert-danger {
  background: linear-gradient(135deg, var(--danger-color), #991100);
  color: #fff;
}

.alert-warning {
  background: linear-gradient(135deg, var(--warning-color), #92600a);
  color: #fff;
}

.alert-info {
  background: linear-gradient(135deg, var(--info-color), #224466);
  color: #fff;
}

/* ============================================================
   TABLES
   ============================================================ */
.table {
  color: var(--text-primary);
  border-color: var(--border-color);
}

.table> :not(caption)>*>* {
  background-color: transparent;
  color: var(--text-primary);
  border-bottom-color: var(--border-color);
  padding: 6px 12px 1rem;
}

.table thead th {
  background-color: var(--bg-tertiary);
  color: var(--text-secondary);
  font-weight: 600;
  font-size: 0.8125rem;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  border-bottom: 2px solid var(--border-color);
}

.table-hover tbody tr:hover>* {
  background-color: var(--bg-hover);
}

.table-bordered th,
.table-bordered td {
  border: 1px solid var(--border-color);
}

/* ============================================================
   FORMS
   ============================================================ */
.form-control,
.form-select {
  background-color: var(--input-bg);
  border: 1.5px solid var(--input-border);
  color: var(--text-primary);
  border-radius: 8px;
  padding: 0.6rem 0.875rem;
  font-size: 0.9375rem;
  transition: border-color 0.2s, box-shadow 0.2s;
}

.form-control:focus,
.form-select:focus {
  background-color: var(--input-bg);
  border-color: var(--input-focus-border);
  color: var(--text-primary);
  box-shadow: var(--input-focus-shadow);
  outline: none;
}

.form-control::placeholder {
  color: var(--text-muted);
  opacity: 0.75;
}

.form-label {
  color: var(--text-primary);
  font-weight: 600;
  margin-bottom: 0.4rem;
  font-size: 0.9rem;
}

.form-text {
  color: var(--text-secondary);
  font-size: 0.8125rem;
}

.form-check-input {
  background-color: var(--input-bg);
  border: 1.5px solid var(--input-border);
  width: 1.1rem;
  height: 1.1rem;
  cursor: pointer;
}

.form-check-input:checked {
  background-color: var(--primary-color);
  border-color: var(--primary-color);
}

.form-check-label {
  color: var(--text-primary);
  cursor: pointer;
  margin-left: 0.4rem;
}

.form-select option {
  background-color: var(--bg-secondary);
  color: var(--text-primary);
}

/* ============================================================
   BADGES
   ============================================================ */
.badge {
  font-weight: 600;
  padding: 0.3rem 0.625rem;
  border-radius: 6px;
  font-size: 0.6875rem;
  letter-spacing: 0.02em;
}

.badge-primary {
  background: var(--primary-gradient);
  color: #fff;
}

.badge-success {
  background: var(--success-color);
  color: #fff;
}

.badge-danger {
  background: var(--danger-color);
  color: #fff;
}

.badge-warning {
  background: var(--warning-color);
  color: #fff;
}

.badge-info {
  background: var(--info-color);
  color: #fff;
}

.badge-secondary {
  background: var(--secondary-color);
  color: #fff;
}

/* Bootstrap bg utilities */
.bg-primary {
  background: var(--primary-gradient) !important;
  color: #fff !important;
}

.bg-success {
  background-color: var(--success-color) !important;
  color: #fff !important;
}

.bg-danger {
  background-color: var(--danger-color) !important;
  color: #fff !important;
}

.bg-warning {
  background-color: var(--warning-color) !important;
  color: #fff !important;
}

.bg-info {
  background-color: var(--info-color) !important;
  color: #fff !important;
}

.bg-secondary {
  background-color: var(--secondary-color) !important;
  color: #fff !important;
}

/* ============================================================
   PAGINATION
   ============================================================ */
.pagination {
  gap: 0.375rem;
}

.page-link {
  background-color: var(--bg-card);
  border: 1.5px solid var(--border-color);
  color: var(--text-primary);
  border-radius: 7px;
  padding: 0.4rem 0.75rem;
  font-weight: 500;
}

.page-link:hover {
  background-color: var(--bg-hover);
  border-color: var(--primary-color);
  color: var(--text-primary);
  transform: translateY(-1px);
}

.page-item.active .page-link {
  background: var(--primary-gradient);
  border-color: transparent;
  color: var(--text-white);
  box-shadow: var(--shadow-md);
}

.page-item.disabled .page-link {
  background: var(--bg-tertiary);
  border-color: var(--border-color);
  color: var(--text-muted);
  opacity: 0.5;
  cursor: not-allowed;
}

/* ============================================================
   LIST GROUPS
   ============================================================ */
.list-group-item {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  color: var(--text-primary);
  padding: 0.875rem 1.125rem;
}

.list-group-item:hover {
  background-color: var(--bg-hover);
  transform: translateX(3px);
}

.list-group-item.active {
  background: var(--primary-gradient);
  border-color: transparent;
  color: var(--text-white);
}

/* ============================================================
   MODALS
   ============================================================ */
.modal-content {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 14px;
  box-shadow: var(--shadow-xl);
  color: var(--text-primary);
}

.modal-header {
  border-bottom: 1px solid var(--border-color);
  background: var(--bg-tertiary);
  border-radius: 14px 14px 0 0;
  padding: 1.125rem 1.5rem;
}

.modal-title {
  color: var(--text-primary);
  font-weight: 700;
  font-size: 1.125rem;
}

.modal-body {
  background-color: var(--bg-card);
  color: var(--text-primary);
  padding: 1.5rem;
}

.modal-footer {
  border-top: 1px solid var(--border-color);
  background: var(--bg-tertiary);
  border-radius: 0 0 14px 14px;
  padding: 1rem 1.5rem;
}

.btn-close {
  filter: var(--btn-close-filter);
}

[data-theme="dark"] .modal-backdrop {
  background-color: rgba(0, 0, 0, 0.85);
}

/* ============================================================
   DROPDOWNS (Bootstrap) — scoped away from sidebar nav
   ============================================================ */
.dropdown-menu:not(.equiper-sidebar .dropdown-menu) {
  background-color: var(--bg-card);
  border: 1px solid var(--border-color);
  border-radius: 10px;
  box-shadow: var(--shadow-md);
  padding: 0.375rem;
}

/* Sidebar nav dropdown — no decoration at all */
.equiper-sidebar .dropdown-menu {
  background-color: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  box-shadow: none !important;
  padding: 0 !important;
}

.dropdown-item {
  color: var(--text-primary);
  border-radius: 7px;
  padding: 0.5rem 0.875rem;
  font-size: 0.9rem;
}

.dropdown-item:hover,
.dropdown-item:focus {
  background-color: var(--bg-hover);
  color: var(--text-primary);
}

.dropdown-item.active,
.dropdown-item:active {
  background: var(--primary-gradient);
  color: var(--text-white);
}

.dropdown-divider {
  border-color: var(--border-color);
  margin: 0.25rem 0;
}

/* ============================================================
   SCROLLBAR
   ============================================================ */
::-webkit-scrollbar {
  width: 8px;
  height: 8px;
}

::-webkit-scrollbar-track {
  background: var(--scrollbar-track);
  border-radius: 10px;
}

::-webkit-scrollbar-thumb {
  background: var(--scrollbar-thumb);
  border-radius: 10px;
  border: 2px solid var(--scrollbar-track);
}

::-webkit-scrollbar-thumb:hover {
  background: var(--scrollbar-thumb-hover);
}

* {
  scrollbar-width: thin;
  scrollbar-color: var(--scrollbar-thumb) var(--scrollbar-track);
}

/* ============================================================
   DARK MODE — Bootstrap text override pass
   Prevents dark-on-dark rendering on Bootstrap components
   ============================================================ */
[data-theme="dark"] body,
[data-theme="dark"] h1,
[data-theme="dark"] h2,
[data-theme="dark"] h3,
[data-theme="dark"] h4,
[data-theme="dark"] h5,
[data-theme="dark"] h6,
[data-theme="dark"] p,
[data-theme="dark"] label,
[data-theme="dark"] .form-label,
[data-theme="dark"] .form-check-label,
[data-theme="dark"] .form-text,
[data-theme="dark"] .card-body,
[data-theme="dark"] .card-header,
[data-theme="dark"] .card-footer,
[data-theme="dark"] .table td,
[data-theme="dark"] .table th,
[data-theme="dark"] .table thead th,
[data-theme="dark"] .modal-title,
[data-theme="dark"] .modal-body,
[data-theme="dark"] .list-group-item,
[data-theme="dark"] .dropdown-item,
[data-theme="dark"] .page-link {
  color: var(--text-primary);
}

[data-theme="dark"] span:not(.badge):not([class*="badge"]):not(.notification-count) {
  color: inherit;
}

[data-theme="dark"] .text-secondary,
[data-theme="dark"] .text-muted,
[data-theme="dark"] small,
[data-theme="dark"] .small {
  color: var(--text-secondary) !important;
}

/* Keep white text on coloured backgrounds */
[data-theme="dark"] .badge,
[data-theme="dark"] .alert,
[data-theme="dark"] .alert *,
[data-theme="dark"] .page-item.active .page-link,
[data-theme="dark"] .list-group-item.active,
[data-theme="dark"] .btn-primary,
[data-theme="dark"] .btn-success,
[data-theme="dark"] .btn-danger,
[data-theme="dark"] .btn-warning,
[data-theme="dark"] .btn-info {
  color: #ffffff !important;
}

[data-theme="dark"] .page-item.disabled .page-link {
  color: var(--text-muted) !important;
  opacity: 0.5;
}

/* ============================================================
   UTILITIES
   ============================================================ */
.text-white {
  color: var(--text-white) !important;
}

.bg-gradient-primary {
  background: var(--primary-gradient) !important;
  color: #fff !important;
}

.shadow-sm {
  box-shadow: var(--shadow-sm) !important;
}

.shadow-md {
  box-shadow: var(--shadow-md) !important;
}

.shadow-lg {
  box-shadow: var(--shadow-lg) !important;
}

.shadow-xl {
  box-shadow: var(--shadow-xl) !important;
}
