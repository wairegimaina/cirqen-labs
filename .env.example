# ============================================================
# Cirqen — environment template. Copy to .env and fill in real values.
#   cp .env.example .env
# .env is git-ignored. NEVER commit real credentials.
# ============================================================

# ── Sync agent → HQ API ──────────────────────────────────────
# HQ addresses override config.json in production too; unset = the default in
# config.py (HQ_ENDPOINT_DEFAULTS). See README, "Where HQ is hosted".
SYNC_API_URL=https://your-hq-server.example.com/api/sync
SYNC_AUTH_TOKEN=<per-client-sync-token>
# New installs: an enrollment code instead of a token (see SECURITY.md)
SYNC_ENROLLMENT_CODE=

# ── Local PostgreSQL ─────────────────────────────────────────
POSTGRES_LOCAL_HOST=127.0.0.1
POSTGRES_LOCAL_PORT=2215
POSTGRES_LOCAL_DB=cirqen1
POSTGRES_LOCAL_USER=cirqen1
POSTGRES_LOCAL_PASSWORD=<local-db-password>

# ── HQ PostgreSQL ────────────────────────────────────────────
POSTGRES_HQ_HOST=<hq-db-host>
POSTGRES_HQ_PORT=5432
POSTGRES_HQ_DB=<hq-db-name>
POSTGRES_HQ_USER=<hq-db-user>
POSTGRES_HQ_PASSWORD=<hq-db-password>

# ── Update system (HQ FastAPI) ───────────────────────────────
HQ_SERVER_URL=https://your-hq-updates.example.com
HQ_API_KEY=<hq-api-key>
